{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Abyss Injector",
  "version": "0.2.0",
  "identifier": "cc.abyss.injector",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Abyss Injector",
        "width": 760,
        "height": 480,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lemonnv39/abyss-cord/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2RURBRUZGQTMxODlEQzEKUldUQm5SaWovNjd0NXAwd1kvalQzTEQ0ZUhPellkQWlOMFd1ZlZjeENpL284dUJKVnQ3NFhNbEUK"
    }
  }
}
